# 个人信息
NUXT_PUBLIC_NAME=Name                         # 姓名
NUXT_PUBLIC_BIRTH_DATE=yyyy-mm-dd             # 出生日期
NUXT_PUBLIC_EMAIL=name@example.com            # 邮箱
NUXT_PUBLIC_GITHUB=https://github.com/example # GitHub 地址
NUXT_PUBLIC_SITE_URL=https://example.com      # 网站地址

# Supabase
SUPABASE_URL=https://example.supabase.co      # 项目 URL
SUPABASE_KEY=sb_publishable_example           # Publishable key
SUPABASE_SECRET_KEY=sb_secret_example        # Secret key（用于笔记 API）

# API Keys
NUXT_AI_GATEWAY_API_KEY=vck_example           # AI: Vercel AI Gateway
NUXT_TAVILY_API_KEY=tvly_example              # AI: 网络搜索 Tavily 
NUXT_TMDB_API_KEY=tmdb_example                # 电影数据: TMDB
NUXT_IGDB_CLIENT_ID=igdb_id_example           # 游戏数据: IGDB
NUXT_IGDB_CLIENT_SECRET=igdb_secret_example   # 游戏数据: IGDB
NUXT_MAPBOX_TOKEN=mapbox_example              # 地图: Mapbox

# Note API
NUXT_NOTE_API_TOKEN=custom_example            # 笔记 API 鉴权 Token